PORT=5000
NODE_ENV=development
# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority
# If omitted or offline, backend will automatically spin up zero-config embedded MongoDB for testing!
MONGODB_URI=
JWT_SECRET=taskflow_jwt_secret_dev_key_super_secure_2026
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
